# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude local override tfvars files, but allow committed environment configurations
# *.tfvars

# Ignore override files as they are usually used for local dev
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock files (decide per project whether to commit)
# .terraform.lock.hcl

# Ignore generated kubeconfigs
kubeconfig*

# Ignore sensitive key files
*.pem
*.key

# Ignore IDE files
.idea/
.vscode/
*.swp
*.swo

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore Lambda zip artifacts
**/rotation_lambda.zip
